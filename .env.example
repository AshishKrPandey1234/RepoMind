# Safe local configuration template. Replace the password locally; never commit a real .env file.
DB_URL=jdbc:mysql://localhost:3306/repomind?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
DB_USERNAME=repomind_app
DB_PASSWORD=replace-with-a-local-secret
GITHUB_CLIENT_ID=replace-with-local-oauth-client-id
GITHUB_CLIENT_SECRET=replace-with-local-oauth-client-secret
GITHUB_REDIRECT_URI=http://localhost:5173/login/oauth2/code/github
FRONTEND_URL=http://localhost:5173
SESSION_COOKIE_SECURE=false
